# Cal.com embed (public — safe to expose in the client)
VITE_CAL_LINK=ritesh-n/15min

# Cloudflare Turnstile — public site key (used later for the contact form)
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets for the contact form (NEVER prefix with VITE_,
# NEVER commit real values — they must live only in the deployment dashboard)
# ---------------------------------------------------------------------------
# Cloudflare Turnstile secret key
TURNSTILE_SECRET_KEY=
# Resend API key (starts with re_)
RESEND_API_KEY=
# Email address that receives contact submissions
CONTACT_EMAIL=
# Verified sender address (Resend domain)
RESEND_FROM=